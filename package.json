{
  "name": "lingoflux-translator",
  "version": "1.3.0",
  "private": true,
  "description": "Fast browser translation with any OpenAI-compatible or Anthropic-compatible provider.",
  "author": "xuanquangIT and LingoFlux contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuanquangIT/AI-Translate-Extension"
  },
  "homepage": "https://github.com/xuanquangIT/AI-Translate-Extension#readme",
  "bugs": {
    "url": "https://github.com/xuanquangIT/AI-Translate-Extension/issues"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "translator",
    "ai",
    "openai-compatible",
    "anthropic-compatible",
    "llm-provider",
    "translation",
    "browser-extension"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:zip": "node scripts/build.mjs --zip",
    "clean": "node scripts/clean.mjs",
    "check:syntax": "node --no-warnings --experimental-vm-modules scripts/check-syntax.mjs",
    "check:extension": "node scripts/validate-extension.mjs",
    "check:agents": "node scripts/sync-agent-config.mjs --check",
    "sync:agents": "node scripts/sync-agent-config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:contract": "node --test \"tests/contract/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:live": "node scripts/smoke-live.mjs",
    "local-mt:setup": "node scripts/local-mt/setup.mjs",
    "local-mt:start": "node scripts/local-mt/start.mjs",
    "local-mt:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-mt/tray.ps1",
    "local-mt:shortcut": "node scripts/local-mt/shortcut.mjs",
    "local-mt:bench": "node scripts/local-mt/bench.mjs",
    "verify": "npm run check:syntax && npm run check:extension && npm run lint && npm run format:check && npm test && npm run check:agents && npm run build",
    "dev": "echo Load src/ as an unpacked extension, then reload it after each change."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module"
}
